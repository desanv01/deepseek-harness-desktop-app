{
  "name": "dsh-plugin-desktop-updates",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Updates and plugin management for the DeepSeek Harness desktop app: a sidebar entry beside Settings and a Settings section, driven by the app's native bridge.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "updates"
  ],
  "homepage": "https://github.com/desanv01/deepseek-harness-desktop-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desanv01/deepseek-harness-desktop-app.git",
    "directory": "plugins/dsh-plugin-desktop-updates"
  },
  "bugs": {
    "url": "https://github.com/desanv01/deepseek-harness-desktop-app/issues"
  },
  "main": "index.js",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
