<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeepSeekHarness</AssemblyName>
    <RootNamespace>DShNative</RootNamespace>
    <!-- Versioning policy: <Version> is the intended release date in
         yyyy.MM.dd form, and we ship at most one release per day. Rebuilds
         within the same day keep the same version; anything not tested in
         time waits for the next day. -->
    <Version>2026.09.24</Version>
    <!-- Ship only the English framework resources; the app has no localized UI. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Official DeepSeek artwork (assets are regenerated by tools\update-icons.ps1):
         light/color variant from https://deepseek.com/favicon.ico
         dark variant (white whale) from https://platform.deepseek.com/favicon.svg -->
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- app.ico is the light-mode window icon and the exe icon; one file, two uses. -->
    <EmbeddedResource Include="assets\app.ico" LogicalName="DShNative.icon-light.ico" />
    <EmbeddedResource Include="assets\icon-dark.ico" LogicalName="DShNative.icon-dark.ico" />
    <!-- Splash loading visual (animated GIFs play automatically) -->
    <EmbeddedResource Include="..\..\assets\source\loading_splash_image.gif" LogicalName="DShNative.splash.gif" />
    <!--
      The updates plugin the app installs into the harness home it owns. It is
      shipped inside the executable so a home can be provisioned with no package
      manager and no network. Sources live in plugins\dsh-plugin-desktop-updates.
    -->
    <EmbeddedResource Include="..\..\plugins\dsh-plugin-desktop-updates\client.js" LogicalName="DShNative.plugin.client.js" />
    <EmbeddedResource Include="..\..\plugins\dsh-plugin-desktop-updates\index.js" LogicalName="DShNative.plugin.index.js" />
    <EmbeddedResource Include="..\..\plugins\dsh-plugin-desktop-updates\package.json" LogicalName="DShNative.plugin.package.json" />
    <EmbeddedResource Include="..\..\plugins\dsh-plugin-desktop-updates\cordis.patch.yml" LogicalName="DShNative.plugin.cordis.patch.yml" />
    <!--
      The log bridge: records the harness's own runtime warnings and errors into
      the app's log. Sources live in plugins\dsh-plugin-log-bridge. Its own
      resource prefix, because the two plugins share file names.
    -->
    <EmbeddedResource Include="..\..\plugins\dsh-plugin-log-bridge\index.js" LogicalName="DShNative.logbridge.index.js" />
    <EmbeddedResource Include="..\..\plugins\dsh-plugin-log-bridge\package.json" LogicalName="DShNative.logbridge.package.json" />
    <EmbeddedResource Include="..\..\plugins\dsh-plugin-log-bridge\cordis.patch.yml" LogicalName="DShNative.logbridge.cordis.patch.yml" />
    <!--
      The pnpm runtime used to install third-party plugins. It is fetched by
      build.ps1 into assets\pnpm (git-ignored, ~12 MB) and embedded when present;
      a build without it still works, because the app fetches the runtime with
      npm the first time a plugin is installed.
    -->
    <EmbeddedResource Include="..\..\assets\pnpm\pnpm.mjs" LogicalName="DShNative.pnpm.pnpm.mjs" Condition="Exists('..\..\assets\pnpm\pnpm.mjs')" />
    <EmbeddedResource Include="..\..\assets\pnpm\worker.js" LogicalName="DShNative.pnpm.worker.js" Condition="Exists('..\..\assets\pnpm\worker.js')" />
  </ItemGroup>

</Project>
